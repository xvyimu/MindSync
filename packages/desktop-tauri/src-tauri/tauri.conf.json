{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindSync",
  "version": "2.11.7",
  "identifier": "com.xvyimu.mindsync",
  "build": {
    "devUrl": "http://localhost:18181",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MindSync",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
